flowchart LR
    subgraph VNET["Azure VNet: vnet-poc 10.10.0.0/24 (Korea Central) - 온프렘 대체"]
        subgraph SNETGW["snet-gw 10.10.0.0/27"]
            VM["vm-opdg (D4s_v5, 10.10.0.4)<br/>On-premises Data Gateway: opdg-poc-01<br/>SQL Server 2022 Express (SAP BW 대체)"]
        end
        subgraph SNETPE["snet-pe 10.10.0.32/27"]
            PE["Private Endpoint: pe-ws-poc-wspl<br/>group: workspace<br/>10.10.0.36~41"]
        end
        DNS["Private DNS Zone<br/>privatelink.fabric.microsoft.com"]
        NAT["NAT Gateway<br/>natgw-poc"]
    end

    subgraph AZPUB["Microsoft Public Endpoints"]
        RELAY["Azure Relay<br/>*.servicebus.windows.net<br/>(Gateway 제어 채널)"]
        PUBAPI["api.fabric.microsoft.com<br/>onelake.dfs.fabric.microsoft.com"]
    end

    subgraph FABRIC["Microsoft Fabric (F2)"]
        PLS["pls-ws-poc-wspl<br/>Microsoft.Fabric/privateLinkServicesForFabric"]
