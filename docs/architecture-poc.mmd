            PLB["pl_copy_opdg_sql"] --> LHB[("lh_poc")]
        end
        subgraph WSW["ws-poc-wspl (Inbound: Deny)"]
            PLW["pl_copy_opdg_sql"] --> LHW[("lh_poc")]
        end
    end

    CLIENT["외부 클라이언트<br/>(Public Internet)"]

    VM -- "① 파이프라인 실행 (workspace FQDN)" --> PE
    PE --> PLS --> WSW
    VM -. "DNS 조회" .-> DNS
    VM -- "② 제어 채널 (Outbound 443)" --> NAT --> RELAY
    RELAY <--> FABRIC
    VM -- "③ OneLake 쓰기<br/>{ws}.z18.dfs → 10.10.0.39" --> PE
    VM -- "S0: Public 경로 적재" --> NAT --> PUBAPI --> WSB
    CLIENT -. "403 RequestDeniedByInboundPolicy" .-x WSW
